MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=backup
MYSQL_PASSWORD=replace-me
# Space separated; empty means all databases.
MYSQL_DATABASES=
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=my-backups
S3_PREFIX=mysql
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
BACKUP_TIMEOUT=2h
# Empty: run once. For a persistent Docker container, set e.g. 24h.
# Kubernetes Deployment sets this explicitly to 24h.
BACKUP_INTERVAL=
